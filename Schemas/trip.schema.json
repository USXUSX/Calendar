{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calendar.local/schemas/trip.schema.json",
  "title": "Calendar Trip",
  "description": "Calendarが変換なしで表示する完全な旅行JSON。値がない任意情報はキーを省略せずnullまたは空配列にする。",
  "$ref": "#/$defs/trip",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "clock": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "nullableString": { "type": ["string", "null"] },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "start", "end", "durationMinutes"],
      "properties": {
        "mode": { "enum": ["fixed", "range", "undecided"] },
        "start": { "$ref": "#/$defs/clock" },
        "end": { "$ref": "#/$defs/clock" },
        "durationMinutes": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "placeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidatePlaceIds", "selection", "minSelections", "maxSelections"],
      "properties": {
        "candidatePlaceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "selection": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "minSelections": { "type": ["integer", "null"], "minimum": 0 },
        "maxSelections": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "scheduleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dayId", "order", "action", "category", "summary", "details", "time", "placeSelection"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dayId": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 0 },
        "action": { "type": "string", "minLength": 1 },
        "category": { "enum": ["sightseeing", "food", "accommodation"] },
        "summary": { "$ref": "#/$defs/nullableString" },
        "details": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "time": { "$ref": "#/$defs/time" },
        "placeSelection": { "$ref": "#/$defs/placeSelection" }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "title", "routeSummary", "scheduleItems", "transportIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/date" },
        "title": { "type": "string", "minLength": 1 },
        "routeSummary": { "$ref": "#/$defs/nullableString" },
        "scheduleItems": { "type": "array", "items": { "$ref": "#/$defs/scheduleItem" } },
        "transportIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dayId", "order", "mode", "fromPlaceId", "toPlaceId", "time", "bookingId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dayId": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["walk", "train", "bus", "car", "ferry", "flight", "other"] },
        "fromPlaceId": { "$ref": "#/$defs/id" },
        "toPlaceId": { "$ref": "#/$defs/id" },
        "time": { "$ref": "#/$defs/time" },
        "bookingId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "rating": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "source", "observedAt"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 5 },
        "source": { "enum": ["食べログ", "楽天トラベル"] },
        "observedAt": { "$ref": "#/$defs/date" }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "category", "address", "location", "urls", "rating"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/nullableString" },
        "category": { "enum": ["restaurant", "hotel", "station", "attraction", "other"] },
        "address": { "$ref": "#/$defs/nullableString" },
        "location": { "$ref": "#/$defs/location" },
        "urls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^https://" } },
        "rating": { "$ref": "#/$defs/rating" }
      }
    },
    "preparationTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "dueDate", "completed", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "dueDate": { "$ref": "#/$defs/date" },
        "completed": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tasks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/preparationTask" } }
      }
    },
    "packingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "completed", "notNeeded", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "completed": { "type": "boolean" },
        "notNeeded": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "rioPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicable", "careMode", "careDecisionDueDate", "careDetails", "packingTemplate", "packingItems"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "applicable": { "type": "boolean" },
        "careMode": { "enum": ["accompany", "leave", "undecided", "not_applicable"] },
        "careDecisionDueDate": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "careDetails": { "$ref": "#/$defs/nullableString" },
        "packingTemplate": { "$ref": "#/$defs/nullableString" },
        "packingItems": { "type": "array", "items": { "$ref": "#/$defs/packingItem" } }
      }
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "targetDate", "placeId", "transportId", "label", "amount", "currency", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "enum": ["accommodation", "transport", "activity", "other"] },
        "status": { "enum": ["pending", "booked", "change_required", "cancelled"] },
        "targetDate": { "$ref": "#/$defs/date" },
        "placeId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "transportId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "label": { "$ref": "#/$defs/nullableString" },
        "amount": { "type": ["integer", "null"], "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "notes": { "$ref": "#/$defs/nullableString" }
      }
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "dateRange", "summary", "days", "places", "transports", "preparation", "rioPlan", "bookings"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "dateRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": { "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" } }
        },
        "summary": { "$ref": "#/$defs/nullableString" },
        "days": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/day" } },
        "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
        "transports": { "type": "array", "items": { "$ref": "#/$defs/transport" } },
        "preparation": { "$ref": "#/$defs/preparation" },
        "rioPlan": { "$ref": "#/$defs/rioPlan" },
        "bookings": { "type": "array", "items": { "$ref": "#/$defs/booking" } }
      }
    }
  }
}
